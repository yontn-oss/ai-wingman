exports[`generateHybridSearchBm25 > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Pure BM25 scorer — no external dependencies.
// BM25 ranks documents by term frequency (TF) and inverse document frequency (IDF),
// normalised by document length. Adjust K1 and B to tune retrieval behaviour.
//
// See: https://en.wikipedia.org/wiki/Okapi_BM25

const K1 = 1.5  // Term frequency saturation (higher = more weight to rare terms)
const B = 0.75  // Document length normalisation (1.0 = full normalisation, 0 = none)

function tokenize(text: string): string[] {
  return text.toLowerCase().match(/\\b\\w+\\b/g) ?? []
}

export interface BM25Document {
  id: string
  text: string
}

/**
 * Score all documents against a query and return the top-K results sorted by score.
 * Returns an empty array if there are no documents or query terms.
 */
export function scoreBM25(
  docs: BM25Document[],
  query: string,
  topK = docs.length,
): { id: string; score: number }[] {
  if (docs.length === 0) return []

  const queryTerms = tokenize(query)
  if (queryTerms.length === 0) return []

  const tokenizedDocs = docs.map((d) => tokenize(d.text))
  const avgLen = tokenizedDocs.reduce((s, t) => s + t.length, 0) / tokenizedDocs.length

  // Build document frequency map
  const df = new Map<string, number>()
  for (const terms of tokenizedDocs) {
    for (const term of new Set(terms)) {
      df.set(term, (df.get(term) ?? 0) + 1)
    }
  }

  const idf = (term: string): number => {
    const n = df.get(term) ?? 0
    return Math.log((docs.length - n + 0.5) / (n + 0.5) + 1)
  }

  const scores = docs.map((doc, i) => {
    const terms = tokenizedDocs[i]!
    const len = terms.length
    const tf = new Map<string, number>()
    for (const term of terms) tf.set(term, (tf.get(term) ?? 0) + 1)

    let score = 0
    for (const term of queryTerms) {
      const f = tf.get(term) ?? 0
      if (f === 0) continue
      score += idf(term) * (f * (K1 + 1)) / (f + K1 * (1 - B + B * (len / avgLen)))
    }
    return { id: doc.id, score }
  })

  return scores
    .filter((s) => s.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, topK)
}
"
`;

exports[`generateHybridSearchReranker > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Reciprocal Rank Fusion (RRF) — merges multiple ranked lists into a single ranking.
// Each list contributes a score of 1 / (k + rank + 1) per document; scores are summed.
// RRF is robust across different scoring scales and requires no calibration.
//
// See: https://plg.uwaterloo.ca/~gvcormac/cormacksigir09-rrf.pdf

/** Constant from the original RRF paper. Higher values reduce the impact of top-ranked items. */
const RRF_K = 60

export interface RankedItem {
  id: string
  /** 0-indexed rank within its source list */
  rank: number
}

/**
 * Fuse multiple ranked lists into one using Reciprocal Rank Fusion.
 * Returns results sorted by descending score, limited to topK.
 */
export function reciprocalRankFusion(
  rankings: RankedItem[][],
  topK = Infinity,
): { id: string; score: number }[] {
  const scores = new Map<string, number>()

  for (const ranking of rankings) {
    for (const { id, rank } of ranking) {
      scores.set(id, (scores.get(id) ?? 0) + 1 / (RRF_K + rank + 1))
    }
  }

  const sorted = [...scores.entries()]
    .map(([id, score]) => ({ id, score }))
    .sort((a, b) => b.score - a.score)

  return topK === Infinity ? sorted : sorted.slice(0, topK)
}
"
`;

exports[`generateHybridSearchRoute > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Hybrid search route: runs vector similarity and BM25 keyword search in parallel,
// then merges results with Reciprocal Rank Fusion before generating an answer.
//
// To index documents, call POST /api/rag/embed (or your embed route) using
// getHybridStore() instead of getRagStore() so getAll() is available for BM25.
//
// See: https://ai-sdk.dev/docs/ai-sdk-core/embeddings

import { embed, generateText } from 'ai'
import { openai } from '@ai-sdk/openai'
import { getHybridStore } from '@/lib/rag/hybrid-store'
import { scoreBM25 } from '@/lib/rag/bm25'
import { reciprocalRankFusion } from '@/lib/rag/reranker'

export const maxDuration = 30

export async function POST(req: Request) {
  // TODO: bring your own auth
  // Add session validation here before processing messages. Example with NextAuth:
  //   import { auth } from '@/auth'
  //   const session = await auth()
  //   if (!session) return new Response('Unauthorized', { status: 401 })

  const { query, topK = 5 } = await req.json()
  if (!query?.trim()) return Response.json({ error: 'query is required' }, { status: 400 })

  const store = getHybridStore()

  // Run embedding + fetch all docs in parallel
  const [{ embedding }, allDocs] = await Promise.all([
    embed({
      model: openai.embedding('text-embedding-3-small'),
      value: query,
    }),
    store.getAll(),
  ])

  // Run vector and keyword search in parallel
  const [vectorResults, bm25Results] = await Promise.all([
    store.query({ embedding, topK: topK * 3 }),
    Promise.resolve(scoreBM25(allDocs, query, topK * 3)),
  ])

  // Merge with Reciprocal Rank Fusion
  const merged = reciprocalRankFusion(
    [
      vectorResults.map((c, i) => ({ id: c.id, rank: i })),
      bm25Results.map((r, i) => ({ id: r.id, rank: i })),
    ],
    topK,
  )

  const docMap = new Map(allDocs.map((d) => [d.id, d.text]))
  const context = merged.map((r) => docMap.get(r.id) ?? '').filter(Boolean).join('\\n\\n')

  const { text } = await generateText({
    model: openai("gpt-5.4-nano"),
    system: [
      'Answer using only the context below. If the answer is not in the context, say so.',
      '',
      'Context:',
      context,
    ].join('\\n'),
    prompt: query,
  })

  return Response.json({ text, sources: merged })
}
"
`;

exports[`generateHybridSearchStore > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Extended RAG store that adds getAll() for BM25 keyword search.
// Implements the same upsert / query interface as the rag pattern's RagStore,
// so it is a drop-in upgrade — swap getRagStore() for getHybridStore() in your
// embed route and this store handles both vector and keyword search.

import { cosineSimilarity } from 'ai'

export interface HybridChunk {
  id: string
  text: string
  embedding?: number[]
}

export interface HybridStore {
  upsert(chunk: Required<HybridChunk>): Promise<void>
  query(params: { embedding: number[]; topK: number }): Promise<HybridChunk[]>
  /** Returns all stored chunks (text only — no embeddings) for BM25 scoring. */
  getAll(): Promise<HybridChunk[]>
}

export class MemoryHybridStore implements HybridStore {
  private chunks: Required<HybridChunk>[] = []

  async upsert(chunk: Required<HybridChunk>): Promise<void> {
    const idx = this.chunks.findIndex((c) => c.id === chunk.id)
    if (idx >= 0) {
      this.chunks[idx] = chunk
    } else {
      this.chunks.push(chunk)
    }
  }

  async query({ embedding, topK }: { embedding: number[]; topK: number }): Promise<HybridChunk[]> {
    return this.chunks
      .map((c) => ({ chunk: c, score: cosineSimilarity(embedding, c.embedding) }))
      .sort((a, b) => b.score - a.score)
      .slice(0, topK)
      .map(({ chunk }) => ({ id: chunk.id, text: chunk.text }))
  }

  async getAll(): Promise<HybridChunk[]> {
    return this.chunks.map((c) => ({ id: c.id, text: c.text }))
  }
}

let _store: HybridStore | undefined

export function getHybridStore(): HybridStore {
  if (!_store) _store = new MemoryHybridStore()
  return _store
}
"
`;
