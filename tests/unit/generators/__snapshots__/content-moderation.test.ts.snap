exports[`generateContentModerationPolicy > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
// Add, remove, or edit categories to match your content policy.
// Each category is injected into the model's system prompt at runtime.

export interface PolicyCategory {
  name: string
  description: string
}

export const POLICY_CATEGORIES: PolicyCategory[] = [
  {
    name: 'hate-speech',
    description: 'Content that attacks or demeans groups based on protected characteristics',
  },
  {
    name: 'violence',
    description: 'Graphic descriptions or incitement of physical harm',
  },
  {
    name: 'spam',
    description: 'Unsolicited promotional content, repetitive noise, or automated gibberish',
  },
  {
    name: 'adult-content',
    description: 'Explicit sexual material not appropriate for general audiences',
  },
  {
    name: 'personal-information',
    description: 'Requests to share or expose sensitive personal data (passwords, SSNs, etc.)',
  },
]
"
`;

exports[`generateContentModerationRoute > snapshot — no auth 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Content moderation route: classifies input against your policy categories.
// Edit lib/moderation/policy.ts to add, remove, or rename categories.
//
// See: https://ai-sdk.dev/docs/reference/ai-sdk-core/generate-text

import { generateText, Output } from 'ai'
import { anthropic } from '@ai-sdk/anthropic'
import { z } from 'zod'
import { POLICY_CATEGORIES } from '@/lib/moderation/policy'

export const maxDuration = 30

const moderationSchema = z.object({
  allowed: z.boolean().describe('Whether the content passes the policy'),
  category: z.string().describe('The violated policy category, or "none" if content is allowed'),
  reason: z.string().describe('Brief explanation of the decision'),
})

export async function POST(req: Request) {
  // TODO: bring your own auth
  // Add session validation here before processing messages. Example with NextAuth:
  //   import { auth } from '@/auth'
  //   const session = await auth()
  //   if (!session) return new Response('Unauthorized', { status: 401 })

  const { input } = await req.json()
  if (!input?.trim()) return Response.json({ error: 'input is required' }, { status: 400 })

  const categoryList = POLICY_CATEGORIES
    .map((c) => \`- \${c.name}: \${c.description}\`)
    .join('\\n')

  const { output } = await generateText({
    model: anthropic("claude-opus-4-5"),
    output: Output.object({ schema: moderationSchema }),
    system:
      'You are a content moderation classifier. Evaluate whether the content violates any policy.\\n\\n' +
      \`Policy categories:\\n\${categoryList}\\n\\n\` +
      'Return allowed: true if safe. If it violates a policy, set allowed: false, ' +
      'category to the violated category name, and reason to a brief explanation.',
    prompt: input,
  })

  return Response.json(output)
}
"
`;
