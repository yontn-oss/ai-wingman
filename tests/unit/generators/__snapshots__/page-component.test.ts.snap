                const userText = msg.parts
                  .filter((p) => p.type === 'text')
                  .map((p) => (p as { text: string }).text)
                  .join('')
                return (
                  <Message key={msg.id} from="user">
                    <MessageContent>{userText}</MessageContent>
                  </Message>
                )
