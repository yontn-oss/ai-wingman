  function getBranchTexts(bucketId: string): string[] {
    const saved = savedBranches[bucketId] ?? []
    const current = messages
      .find((m) => m.role === 'assistant' && (savedBranches[bucketId] !== undefined || m.id === bucketId || true))
    // Walk forward from last user message to find the live assistant message
    const bucketIdx = messages.findIndex((m) => m.id === bucketId)
    const liveAssistant = bucketIdx >= 0
      ? messages.slice(bucketIdx + 1).find((m) => m.role === 'assistant')
      : messages.slice().reverse().find((m) => m.role === 'assistant')
    void current
    if (!liveAssistant) return saved
    const currentText = liveAssistant.parts
      .filter((p) => p.type === 'text')
      .map((p) => (p as { text: string }).text)
      .join('')
