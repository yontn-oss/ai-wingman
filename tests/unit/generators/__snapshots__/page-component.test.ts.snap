                description="Send a message or pick a suggestion to begin."
              />
              <Suggestions>
                {SUGGESTIONS.map((s) => (
                  <Suggestion key={s} suggestion={s} onClick={handleSuggestion} />
                ))}
              </Suggestions>
            </>
          )}
          {(() => {
