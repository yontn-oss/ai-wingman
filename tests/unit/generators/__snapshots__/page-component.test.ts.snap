  }, [])

  const handleSubmit = useCallback((msg: PromptInputMessage) => {
    if (msg.text?.trim()) sendMessage({ text: msg.text })
  }, [sendMessage])

  const handleSuggestion = useCallback((suggestion: string) => {
    sendMessage({ text: suggestion })
  }, [sendMessage])

