                const currentIdx = selectedBranch[bucketId] ?? branches.length - 1
                const isLast = msg === messages[messages.length - 1]

                const reasoningText = msg.parts
                  .filter((p) => p.type === 'reasoning')
                  .map((p) => (p as { text: string }).text)
                  .join('\\n\\n')

                const isReasoningStreaming =
                  isLast && status === 'streaming' && msg.parts.at(-1)?.type === 'reasoning'

                const sourceParts = msg.parts.filter((p) => p.type === 'source-url')

                const toolParts = msg.parts.filter(isToolUIPart)

                if (branches.length === 0 && !reasoningText && sourceParts.length === 0 && toolParts.length === 0) return null

                return (
                  <Message key={msg.id} from="assistant">
                    {reasoningText && (
                      <Reasoning isStreaming={isReasoningStreaming}>
                        <ReasoningTrigger />
                        <ReasoningContent>{reasoningText}</ReasoningContent>
                      </Reasoning>
                    )}
                    {sourceParts.length > 0 && (
                      <Sources>
                        <SourcesTrigger count={sourceParts.length} />
                        <SourcesContent>
                          {sourceParts.map((p, i) => (
                            <Source key={i} href={(p as any).url} title={(p as any).url} />
                          ))}
                        </SourcesContent>
                      </Sources>
                    )}
                    {toolParts.map((p) => (
                      <MessageContent key={p.toolCallId}>
                        <span className="font-mono text-xs text-muted-foreground">
                          {String(p.type).replace('tool-', '')}
                          {p.state === 'input-available' || p.state === 'approval-requested'
                            ? \`(\${JSON.stringify(p.input)})\` : ''}
                          {p.state === 'output-available' ? \` → \${JSON.stringify(p.output)}\` : ''}
                          {p.state === 'approval-requested' ? ' ⏳ awaiting approval' : ''}
                          {p.state === 'approval-responded' && p.approval.approved ? ' ✓ approved' : ''}
                          {p.state === 'approval-responded' && !p.approval.approved ? ' ✗ rejected' : ''}
                        </span>
                      </MessageContent>
                    ))}

                    {branches.length > 0 && (
                      <MessageBranch
                        defaultBranch={branches.length - 1}
                        onBranchChange={(idx) =>
                          setSelectedBranch((prev) => ({ ...prev, [bucketId]: idx }))
                        }
                      >
                        <MessageBranchContent>
                          {branches.map((text, bi) => (
                            <MessageContent key={bi}>
                              <MessageResponse>{text}</MessageResponse>
                            </MessageContent>
                          ))}
                        </MessageBranchContent>
                        <MessageToolbar>
                          <MessageActions>
                            <MessageAction
                              tooltip="Copy"
                              onClick={() => copyMessage(branches[currentIdx] ?? '')}
                            >
                              <CopyIcon />
                            </MessageAction>
                            <MessageAction
                              tooltip="Regenerate"
                              onClick={() => regenerate()}
                              disabled={status !== 'ready'}
                            >
                              <RotateCcwIcon />
                            </MessageAction>
                          </MessageActions>
                          <MessageBranchSelector>
                            <MessageBranchPrevious />
                            <MessageBranchPage />
                            <MessageBranchNext />
                          </MessageBranchSelector>
                        </MessageToolbar>
                      </MessageBranch>
                    )}
                  </Message>
                )
              }

              return null
            })
          })()}
        </ConversationContent>
        <ConversationScrollButton />
        <ConversationDownload messages={messages} />
      </Conversation>

      <PromptInput onSubmit={handleSubmit} className="border-t">
        <PromptInputBody>
          <PromptInputTextarea placeholder="Type a message..." />
        </PromptInputBody>
        <PromptInputFooter>
          <PromptInputTools>
            {/* TODO: Add tools */}
          </PromptInputTools>
          <PromptInputSubmit status={status} disabled={status !== 'ready'} />
        </PromptInputFooter>
      </PromptInput>
    </>
  )
}

export default function ChatPage() {
  const apiPath = '/api/chat'
  const [conversations, setConversations] = useState<{ id: string; updatedAt: string }[]>([])
  const [conversationId, setConversationId] = useState<string | null>(null)
  const [initialMessages, setInitialMessages] = useState<UIMessage[]>([])

  async function selectConversation(id: string) {
    setConversationId(null)
    try {
      const r = await fetch(\`\${apiPath}/conversations/\${id}\`)
      const data = r.ok ? await r.json() : { messages: [] }
      setInitialMessages((data.messages ?? []) as UIMessage[])
      setConversationId(id)
    } catch {
      setInitialMessages([])
      setConversationId(id)
    }
  }

  async function createConversation() {
    const res = await fetch(\`\${apiPath}/conversations\`, { method: 'POST' })
    const { id } = await res.json() as { id: string }
    setConversationId(id)
    setInitialMessages([])
    setConversations((prev) => [{ id, updatedAt: new Date().toISOString() }, ...prev])
  }

  // On mount: load conversation list; auto-create first conversation if none exist
  useEffect(() => {
    fetch(\`\${apiPath}/conversations\`)
      .then((r) => r.json())
      .then(async (data) => {
        const list = (data as { conversations: { id: string; updatedAt: string }[] }).conversations
        setConversations(list)
        if (list.length > 0) {
          void selectConversation(list[0]!.id)
        } else {
          await createConversation()
        }
      })
      .catch(() => {})
  }, [])

  return (
    <div className="flex h-screen">
      {/* Conversation history sidebar */}
      <div className="w-64 shrink-0 border-r flex flex-col">
        <div className="p-3 border-b">
          <button
            onClick={() => void createConversation()}
            className="w-full text-sm rounded-md border px-3 py-2 hover:bg-accent"
          >
            + New conversation
          </button>
        </div>
        <div className="flex-1 overflow-y-auto">
          {conversations.map((c) => (
            <button
              key={c.id}
              onClick={() => void selectConversation(c.id)}
              className={\`w-full text-left px-3 py-2 text-sm hover:bg-accent truncate \${
                c.id === conversationId ? 'bg-accent font-medium' : ''
              }\`}
            >
              {c.id.slice(0, 8)}…
            </button>
          ))}
        </div>
      </div>

      {/* Chat area */}
      <div className="flex flex-col flex-1 min-w-0">
        {conversationId && (
          <ChatInner
            key={conversationId}
            conversationId={conversationId}
            initialMessages={initialMessages}
          />
        )}
      </div>
    </div>
  )
}
"
`;
