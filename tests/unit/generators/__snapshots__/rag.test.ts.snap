exports[`generateRagHook > snapshot — non-streaming 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.

'use client'

import { useState } from 'react'

export function useRagQuery() {
  const [result, setResult] = useState<string | null>(null)
  const [isLoading, setIsLoading] = useState(false)
  const [error, setError] = useState<Error | null>(null)

  async function query(input: string, topK = 5) {
    setIsLoading(true)
    setError(null)
    try {
      const res = await fetch('/api/rag/query', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: input, topK }),
      })
      const data = await res.json() as { text: string }
      setResult(data.text)
    } catch (err) {
      setError(err instanceof Error ? err : new Error(String(err)))
    } finally {
      setIsLoading(false)
    }
  }

  return { result, isLoading, error, query }
}
"
`;

exports[`generateRagHook > snapshot — streaming 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.

'use client'

import { useRef, useState } from 'react'

export function useRagQuery() {
  const [result, setResult] = useState<string>('')
  const [isLoading, setIsLoading] = useState(false)
  const [error, setError] = useState<Error | null>(null)
  const readerRef = useRef<ReadableStreamDefaultReader<string> | null>(null)

  async function query(input: string, topK = 5) {
    setIsLoading(true)
    setResult('')
    setError(null)

    try {
      const res = await fetch('/api/rag/query', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: input, topK }),
      })

      if (!res.body) throw new Error('No response body')

      const reader = res.body.pipeThrough(new TextDecoderStream()).getReader()
      readerRef.current = reader

      while (true) {
        const { done, value } = await reader.read()
        if (done) break
        setResult((prev) => prev + value)
      }
    } catch (err) {
      setError(err instanceof Error ? err : new Error(String(err)))
    } finally {
      setIsLoading(false)
      readerRef.current = null
    }
  }

  function stop() {
    readerRef.current?.cancel()
  }

  return { result, isLoading, error, query, stop }
}
"
`;

exports[`generateRagMemoryStore > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.

import { cosineSimilarity } from 'ai'
import type { RagChunk, RagStore } from './store.js'

export class MemoryRagStore implements RagStore {
  private chunks: Required<RagChunk>[] = []

  async upsert(chunk: Required<RagChunk>): Promise<void> {
    const idx = this.chunks.findIndex((c) => c.id === chunk.id)
    if (idx >= 0) {
      this.chunks[idx] = chunk
    } else {
      this.chunks.push(chunk)
    }
  }

  async query({ embedding, topK }: { embedding: number[]; topK: number }): Promise<RagChunk[]> {
    return this.chunks
      .map((c) => ({ chunk: c, score: cosineSimilarity(embedding, c.embedding) }))
      .sort((a, b) => b.score - a.score)
      .slice(0, topK)
      .map(({ chunk }) => ({ id: chunk.id, text: chunk.text }))
  }
}
"
`;

exports[`generateRagPgvectorStore > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.

import postgres from 'postgres'
import type { RagChunk, RagStore } from './store.js'

const sql = postgres(process.env['POSTGRES_URL']!)

export class PgvectorRagStore implements RagStore {
  async upsert(chunk: Required<RagChunk>): Promise<void> {
    const vectorLiteral = \`[\${chunk.embedding.join(',')}]\`
    await sql\`
      INSERT INTO rag_chunks (id, text, embedding)
      VALUES (\${chunk.id}, \${chunk.text}, \${vectorLiteral}::vector)
      ON CONFLICT (id) DO UPDATE
        SET text = EXCLUDED.text,
            embedding = EXCLUDED.embedding
    \`
  }

  async query({ embedding, topK }: { embedding: number[]; topK: number }): Promise<RagChunk[]> {
    const vectorLiteral = \`[\${embedding.join(',')}]\`
    const rows = await sql<{ id: string; text: string }[]>\`
      SELECT id, text
      FROM rag_chunks
      ORDER BY embedding <=> \${vectorLiteral}::vector
      LIMIT \${topK}
    \`
    return rows.map((r) => ({ id: r.id, text: r.text }))
  }
}
"
`;

exports[`generateRagQueryRoute > snapshot — auth 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.

import { embed, generateText } from 'ai'
import { anthropic } from '@ai-sdk/anthropic'
import { getRagStore } from '@/lib/rag/store'
import { auth } from '@/auth'

export async function POST(req: Request) {
  const session = await auth()
  if (!session) return new Response('Unauthorized', { status: 401 })

  const { query, topK = 5 } = await req.json()

  const { embedding } = await embed({
    model: (anthropic as any).embedding('text-embedding-3-small'),
    value: query,
  })

  const store = getRagStore()
  const chunks = await store.query({ embedding, topK })
  const context = chunks.map((c) => c.text).join('\\n\\n')

  const result = generateText({
    model: anthropic("claude-opus-4-5"),
    system: [
      'Answer using only the context below. If the answer is not in the context, say so.',
      '',
      'Context:',
      context,
    ].join('\\n'),
    prompt: query,
  })

  return Response.json({ text: result.text })
}
"
`;

