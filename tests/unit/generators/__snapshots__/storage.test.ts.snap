// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateStorage > generates in-memory storage with correct shape 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// This is an in-memory store. Data is lost on server restart.
// TODO: replace with your own database implementation.
//       The storage object only needs to implement the four methods below.

type Messages = unknown[]
const store = new Map<string, Messages>()
const updatedAt = new Map<string, Date>()

export const storage = {
  createConversation(): string {
    const id = crypto.randomUUID()
    store.set(id, [])
    updatedAt.set(id, new Date())
    return id
  },
  listConversations(): { id: string; updatedAt: Date }[] {
    return [...store.keys()]
      .map((id) => ({ id, updatedAt: updatedAt.get(id) ?? new Date(0) }))
      .sort((a, b) => b.updatedAt.getTime() - a.updatedAt.getTime())
  },
  getMessages(conversationId: string): Messages {
    return store.get(conversationId) ?? []
  },
  saveMessages(conversationId: string, messages: Messages): void {
    store.set(conversationId, messages)
    updatedAt.set(conversationId, new Date())
  },
}
"
`;
