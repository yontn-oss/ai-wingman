exports[`generateMultiAgentHandoffTools > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Handoff tools: typed wrappers that let the orchestrator delegate to specialists.
// Add more specialist tools here as your workflow grows.

import { tool } from 'ai'
import { z } from 'zod'
import { researchSpecialist, writerSpecialist } from '@/lib/multi-agent/specialists'
import type { HandoffPayload } from '@/lib/multi-agent/types'

export const handoffTools = {
  callResearcher: tool({
    description: 'Delegate a research sub-task to the research specialist agent.',
    parameters: z.object({
      task: z.string().describe('The research question or information-gathering task'),
      context: z.string().optional().describe('Additional conversation context'),
    }),
    execute: async (args): Promise<string> => {
      const payload: HandoffPayload = args
      return researchSpecialist(payload)
    },
  }),
  callWriter: tool({
    description: 'Delegate a writing or editing sub-task to the writer specialist agent.',
    parameters: z.object({
      task: z.string().describe('The writing or editing task to perform'),
      context: z.string().optional().describe('Research notes or material to incorporate'),
    }),
    execute: async (args): Promise<string> => {
      const payload: HandoffPayload = args
      return writerSpecialist(payload)
    },
  }),
}
"
`;

exports[`generateMultiAgentOrchestratorRoute > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Orchestrator agent: breaks complex tasks into sub-tasks and delegates them to
// specialist agents via handoff tools. Specialists run synchronously within each
// tool call. The orchestrator streams its final synthesis back to the client.

import { convertToModelMessages, stepCountIs, streamText } from 'ai'
import { openai } from '@ai-sdk/openai'
import { handoffTools } from '@/lib/multi-agent/handoff-tools'

// Allow up to 60 seconds — the orchestrator may call multiple specialists in sequence
export const maxDuration = 60

export async function POST(req: Request) {
  // TODO: bring your own auth
  // Add session validation here before processing messages. Example with NextAuth:
  //   import { auth } from '@/auth'
  //   const session = await auth()
  //   if (!session) return new Response('Unauthorized', { status: 401 })

  const { messages } = await req.json()

  try {
    const result = streamText({
      model: openai("gpt-5.4-nano"),
      system:
        'You are an orchestrator. Break complex tasks into focused sub-tasks and' +
        ' delegate each to the appropriate specialist agent using the available tools.' +
        ' Synthesize the specialists\\' results into a coherent final answer.',
      tools: handoffTools,
      stopWhen: stepCountIs(10),
      messages: await convertToModelMessages(messages),
    })
    return result.toUIMessageStreamResponse()
  } catch {
    return Response.json({ error: 'Internal server error' }, { status: 500 })
  }
}
"
`;

exports[`generateMultiAgentSpecialists > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Specialist agents: each receives a HandoffPayload from the orchestrator and
// runs generateText synchronously, returning a plain string result back to the
// orchestrator. Swap generateText for streamText if you need per-specialist
// streaming.

import { generateText } from 'ai'
import { openai } from '@ai-sdk/openai'
import type { HandoffPayload } from '@/lib/multi-agent/types'

export async function researchSpecialist(payload: HandoffPayload): Promise<string> {
  const { text } = await generateText({
    model: openai("gpt-5.4-nano"),
    system: 'You are a research specialist. Find accurate information and summarize it concisely.',
    prompt: payload.context
      ? \`\${payload.task}\\n\\nContext: \${payload.context}\`
      : payload.task,
  })
  return text
}

export async function writerSpecialist(payload: HandoffPayload): Promise<string> {
  const { text } = await generateText({
    model: openai("gpt-5.4-nano"),
    system: 'You are a writing specialist. Produce well-structured, polished prose.',
    prompt: payload.context
      ? \`\${payload.task}\\n\\nMaterial: \${payload.context}\`
      : payload.task,
  })
  return text
}
"
`;

exports[`generateMultiAgentTypes > snapshot 1`] = `
