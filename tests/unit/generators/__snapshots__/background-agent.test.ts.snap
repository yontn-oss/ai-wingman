exports[`generateBackgroundAgentEnqueueRoute > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Enqueue route: creates a job, fires the worker asynchronously, and returns
// the jobId immediately — no waiting for the AI response.
//
// NOTE: void runWorker(...) works in Node.js servers (Railway, Fly, EC2) where
// the process stays alive. On serverless platforms (Vercel, Netlify) the
// function freezes after the response — use a real queue adapter instead.

import { generateId } from 'ai'
import { jobStore } from '@/lib/background-agent/job-store'
import { runWorker } from '@/lib/background-agent/worker'

export async function POST(req: Request) {
  // TODO: bring your own auth
  // Add session validation here before processing messages. Example with NextAuth:
  //   import { auth } from '@/auth'
  //   const session = await auth()
  //   if (!session) return new Response('Unauthorized', { status: 401 })

  const { task } = await req.json()
  if (!task?.trim()) return Response.json({ error: 'task is required' }, { status: 400 })

  const jobId = generateId()
  jobStore.create(jobId, task)

  // Fire-and-forget: worker runs outside the request lifecycle
  void runWorker(jobId, task)

  return Response.json({ jobId }, { status: 202 })
}
"
`;

exports[`generateBackgroundAgentJobStore > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// In-memory job store. Swap for a Redis adapter (Upstash, ioredis) or a
// queue-backed implementation (Inngest, BullMQ) for production.

export type JobStatus = 'pending' | 'running' | 'done' | 'failed'

export interface JobEntry {
  id: string
  task: string
  status: JobStatus
  result?: string
  error?: string
  createdAt: Date
  finishedAt?: Date
}

export interface JobStore {
  create(id: string, task: string): void
  setRunning(id: string): void
  setDone(id: string, result: string): void
  setFailed(id: string, error: string): void
  get(id: string): JobEntry | undefined
}

class InMemoryJobStore implements JobStore {
  private jobs = new Map<string, JobEntry>()

  create(id: string, task: string): void {
    this.jobs.set(id, { id, task, status: 'pending', createdAt: new Date() })
  }

  setRunning(id: string): void {
    const job = this.jobs.get(id)
    if (job) job.status = 'running'
  }

  setDone(id: string, result: string): void {
    const job = this.jobs.get(id)
    if (job) { job.status = 'done'; job.result = result; job.finishedAt = new Date() }
  }

  setFailed(id: string, error: string): void {
    const job = this.jobs.get(id)
    if (job) { job.status = 'failed'; job.error = error; job.finishedAt = new Date() }
  }

  get(id: string): JobEntry | undefined {
    return this.jobs.get(id)
  }
}

// Singleton — shared across hot-reloads in development
const globalForJobs = globalThis as typeof globalThis & { __jobStore?: InMemoryJobStore }
export const jobStore: JobStore = globalForJobs.__jobStore ??= new InMemoryJobStore()
"
`;

exports[`generateBackgroundAgentStatusRoute > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Status/result polling route: returns { status, result?, error? } for a job.
// Poll at a sensible interval (e.g. every 2–5 s) until status === "done" | "failed".

import { jobStore } from '@/lib/background-agent/job-store'

export async function GET(
  _req: Request,
  { params }: { params: Promise<{ jobId: string }> }
) {
  // TODO: bring your own auth
  // Add session validation here before processing messages. Example with NextAuth:
  //   import { auth } from '@/auth'
  //   const session = await auth()
  //   if (!session) return new Response('Unauthorized', { status: 401 })

  const { jobId } = await params
  const job = jobStore.get(jobId)
  if (!job) return Response.json({ error: 'Job not found' }, { status: 404 })

  return Response.json({
    status: job.status,
    ...(job.result !== undefined && { result: job.result }),
    ...(job.error !== undefined && { error: job.error }),
  })
}
"
`;

exports[`generateBackgroundAgentWorker > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Worker function: processes a task outside the HTTP request cycle.
// Called with void (fire-and-forget) from the enqueue route.
// In production, replace this with an Inngest / BullMQ handler that
// receives the job payload from a real queue.

import { generateText, stepCountIs } from 'ai'
import { openai } from '@ai-sdk/openai'
import { jobStore } from '@/lib/background-agent/job-store'

export async function runWorker(jobId: string, task: string): Promise<void> {
  jobStore.setRunning(jobId)
  try {
    const { text } = await generateText({
      model: openai("gpt-5.4-nano"),
      system: 'You are an autonomous background agent. Complete the given task thoroughly and return a complete, self-contained result.',
      prompt: task,
      stopWhen: stepCountIs(20),
    })
    jobStore.setDone(jobId, text)
  } catch (err) {
    jobStore.setFailed(jobId, err instanceof Error ? err.message : 'Unknown error')
  }
}
"
`;
