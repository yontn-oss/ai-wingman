// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateAgentPage > snapshot 1`] = `
"'use client'

// Generated by ai-wingman — edit freely, you own this file.
// TODO: Add layout and styling around this component

import { useCallback, useState } from 'react'
import { useChat } from '@ai-sdk/react'
import { DefaultChatTransport, isToolUIPart } from 'ai'
import {
  Conversation,
  ConversationContent,
  ConversationEmptyState,
  ConversationScrollButton,
} from '@/components/ai-elements/conversation'
import {
  Message,
  MessageContent,
} from '@/components/ai-elements/message'
import {
  PromptInput,
  PromptInputBody,
  PromptInputFooter,
  PromptInputSubmit,
  PromptInputTextarea,
  type PromptInputMessage,
} from '@/components/ai-elements/prompt-input'

const API_PATH = '/api/agent'

export default function AgentPage() {
  // Each page mount gets a fresh conversation ID — the agent resumes it on reload.
  const [conversationId] = useState(() => crypto.randomUUID())

  const { messages, sendMessage, status } = useChat({
    transport: new DefaultChatTransport({
      api: API_PATH,
      body: { conversationId },
    }),
  })

  const handleSubmit = useCallback((msg: PromptInputMessage) => {
    if (msg.text?.trim()) sendMessage({ text: msg.text })
  }, [sendMessage])

  return (
    <div className="flex flex-col h-screen">
      <Conversation>
        <ConversationContent>
          {messages.length === 0 && (
            <ConversationEmptyState
              title="Agent ready"
              description="Describe a task and the agent will use its tools to complete it."
            />
          )}
          {messages.map((msg) => {
            if (msg.role === 'user') {
              const text = msg.parts
                .filter((p) => p.type === 'text')
                .map((p) => (p as { text: string }).text)
                .join('')
              return (
                <Message key={msg.id} from="user">
                  <MessageContent>{text}</MessageContent>
                </Message>
              )
            }

            if (msg.role === 'assistant') {
              const textParts = msg.parts.filter((p) => p.type === 'text')
              const toolParts = msg.parts.filter(isToolUIPart)
              if (textParts.length === 0 && toolParts.length === 0) return null

              return (
                <Message key={msg.id} from="assistant">
                  {textParts.map((p, i) => (
                    <MessageContent key={i}>
                      {(p as { text: string }).text}
                    </MessageContent>
                  ))}
                  {toolParts.map((p) => (
                    <MessageContent key={p.toolCallId}>
                      <span className="font-mono text-xs text-muted-foreground">
                        {String(p.type).replace('tool-', '')}
                        {p.state === 'input-available'
                          ? \`(\${JSON.stringify(p.input)})\` : ''}
                        {p.state === 'output-available'
                          ? \` → \${JSON.stringify(p.output)}\` : ''}
                      </span>
                    </MessageContent>
                  ))}
                </Message>
              )
            }

            return null
          })}
        </ConversationContent>
        <ConversationScrollButton />
      </Conversation>

      <PromptInput onSubmit={handleSubmit} className="border-t">
        <PromptInputBody>
          <PromptInputTextarea placeholder="Describe a task for the agent..." />
        </PromptInputBody>
        <PromptInputFooter>
          <PromptInputSubmit status={status} disabled={status !== 'ready'} />
        </PromptInputFooter>
      </PromptInput>
    </div>
  )
}
"
`;

exports[`generateAgentRoute > snapshot — no auth 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// This is an autonomous agent with persistent memory.
// Each conversation is stored and resumed via conversationId.
// The agent calls tools in a loop (up to maxSteps times) before responding.

import { convertToModelMessages, generateId, stepCountIs, streamText } from 'ai'
import type { UIMessage } from 'ai'
import { anthropic } from '@ai-sdk/anthropic'
import { myAgentTools } from '@/lib/agent-tools/my-agent.tools'
import { storage } from '@/lib/agent-storage'

// Allow streaming responses up to 60 seconds — agents may run multiple tool steps
export const maxDuration = 60

export async function POST(req: Request) {
  // TODO: bring your own auth
  // Add session validation here before processing messages. Example with NextAuth:
  //   import { auth } from '@/auth'
  //   const session = await auth()
  //   if (!session) return new Response('Unauthorized', { status: 401 })

  const { messages, conversationId } = await req.json()

  try {
    const result = streamText({
      model: anthropic("claude-opus-4-5"),
      system: 'You are an autonomous agent. Use the available tools to complete tasks. Think step-by-step, calling tools as needed until the task is done.',
      tools: myAgentTools,
      stopWhen: stepCountIs(20),
      messages: await convertToModelMessages(messages),
      onFinish: async ({ response }) => {
        const assistantMessages: UIMessage[] = response.messages.map((m) => {
          const content = Array.isArray(m.content) ? m.content : [{ type: 'text', text: m.content }]
          return {
            id: generateId(),
            role: m.role as UIMessage['role'],
            parts: (content as Array<{ type: string; text?: string; [k: string]: unknown }>).flatMap((c) => {
              if (c.type === 'text') return [{ type: 'text' as const, text: c.text as string }]
              return []
            }),
            metadata: {},
          }
        })
        await storage.saveMessages(conversationId, [...messages, ...assistantMessages])
      },
    })
    return result.toUIMessageStreamResponse()
  } catch {
    return Response.json({ error: 'Internal server error' }, { status: 500 })
  }
}
"
`;
