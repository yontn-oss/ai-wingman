// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateEvalScript > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Run with:  npx tsx evals/my-eval.ts
//
// This script runs a set of prompts through your model and scores each
// output against criteria you define. Use it to:
//   - Catch regressions when you update your system prompt
//   - Compare model outputs side-by-side before shipping
//   - Track quality trends over time (pipe output to a JSON file)
//
// Scoring is done by a second LLM call — the "judge" model. You can swap it
// for a simpler heuristic (e.g. regex, substring check) if preferred.

import { generateText } from 'ai'
import { anthropic } from '@ai-sdk/anthropic'

// ---------------------------------------------------------------------------
// 1. Configure your eval cases
// ---------------------------------------------------------------------------

interface EvalCase {
  name: string
  systemPrompt: string
  userPrompt: string
  /** Return a score 0–1 and a brief reason. The judge receives the output. */
  score(output: string): Promise<{ score: number; reason: string }>
}

const MODEL = anthropic("claude-opus-4-5")
const JUDGE_MODEL = anthropic("claude-opus-4-5")

// TODO: add your own eval cases here
const evalCases: EvalCase[] = [
  {
    name: 'responds in plain text',
    systemPrompt: 'You are a helpful assistant. Reply concisely.',
    userPrompt: 'What is 2 + 2?',
    async score(output) {
      return output.includes('4')
        ? { score: 1, reason: 'Output contains "4"' }
        : { score: 0, reason: 'Output did not contain "4"' }
    },
  },
  {
    name: 'answers in the language of the question',
    systemPrompt: 'You are a helpful assistant.',
    userPrompt: '¿Cuál es la capital de Francia?',
    async score(output) {
      const { text } = await generateText({
        model: JUDGE_MODEL,
        system: 'You are an evaluator. Score the output on a scale of 0 to 1 and explain why.',
        prompt: [
          'Criterion: The response should be in Spanish.',
          '',
          \`Output: \${output}\`,
          '',
          'Respond with JSON: { "score": <0-1>, "reason": "<brief explanation>" }',
        ].join('\\n'),
      })
      try {
        const json = JSON.parse(text.match(/\\{[^}]+\\}/)?.[0] ?? '{}') as { score?: number; reason?: string }
        return { score: json.score ?? 0, reason: json.reason ?? text }
      } catch {
        return { score: 0, reason: 'Judge returned non-JSON: ' + text }
      }
    },
  },
]

// ---------------------------------------------------------------------------
// 2. Run the eval loop
// ---------------------------------------------------------------------------

async function runEvals() {
  console.log('Running evals...\\n')

  const results: Array<{ name: string; score: number; reason: string; output: string }> = []

  for (const c of evalCases) {
    process.stdout.write(\`  \${c.name} ... \`)

    const { text: output } = await generateText({
      model: MODEL,
      system: c.systemPrompt,
      prompt: c.userPrompt,
    })

    const { score, reason } = await c.score(output)
    results.push({ name: c.name, score, reason, output })

    const icon = score >= 0.8 ? '✓' : score >= 0.5 ? '~' : '✗'
    console.log(\`\${icon}  \${score.toFixed(2)}  \${reason}\`)
  }

  const avg = results.reduce((sum, r) => sum + r.score, 0) / results.length
  console.log(\`\\nAverage score: \${avg.toFixed(2)} / 1.00 (\${results.length} cases)\`)

  const failures = results.filter((r) => r.score < 0.8)
  if (failures.length > 0) {
    console.log(\`\\nFailing cases:\`)
    for (const f of failures) {
      console.log(\`  \${f.name}: \${f.reason}\`)
      console.log(\`  Output: \${f.output.slice(0, 200)}\`)
    }
    process.exit(1)
  }
}

runEvals().catch((err) => {
  console.error(err)
  process.exit(1)
})
"
`;
