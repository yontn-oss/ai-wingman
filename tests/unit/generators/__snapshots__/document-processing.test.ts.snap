exports[`generateDocumentProcessingHook > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.

import { useState } from 'react'
import type { Document } from '@/lib/schemas/document.schema'

export function useDocumentExtract() {
  const [result, setResult] = useState<Document | null>(null)
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState<string | null>(null)

  async function extract(file: File) {
    setLoading(true)
    setError(null)
    setResult(null)
    try {
      const form = new FormData()
      form.append('file', file)
      const res = await fetch('/api/document-processing', { method: 'POST', body: form })
      if (!res.ok) throw new Error(\`Request failed: \${res.status}\`)
      setResult(await res.json() as Document)
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Unknown error')
    } finally {
      setLoading(false)
    }
  }

  return { result, loading, error, extract }
}
"
`;

exports[`generateDocumentProcessingRoute > snapshot — no auth 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Accepts a multipart/form-data upload with a "file" field (PDF or text),
// passes it to the model as a file message part, and returns typed JSON.
//
// Provider support: Anthropic (recommended), Google Gemini.
// OpenAI does not support inline PDF file parts — use text extraction first.
// See: https://sdk.vercel.ai/docs/ai-sdk-core/files

import { generateText, Output } from 'ai'
import { anthropic } from '@ai-sdk/anthropic'
import { documentSchema } from '@/lib/schemas/document.schema'

export const maxDuration = 60

export async function POST(req: Request) {
  // TODO: bring your own auth
  // Add session validation here before processing messages. Example with NextAuth:
  //   import { auth } from '@/auth'
  //   const session = await auth()
  //   if (!session) return new Response('Unauthorized', { status: 401 })

  const form = await req.formData()
  const file = form.get('file') as File | null

  if (!file) {
    return Response.json({ error: 'No file provided' }, { status: 400 })
  }

  const bytes = await file.arrayBuffer()
  const base64 = Buffer.from(bytes).toString('base64')
  const mimeType = file.type || 'application/pdf'

  const { output } = await generateText({
    model: anthropic("claude-opus-4-5"),
    output: Output.object({ schema: documentSchema }),
    messages: [
      {
        role: 'user',
        content: [
          { type: 'file', data: base64, mimeType },
          {
            type: 'text',
            text: 'Extract the structured data from this document. Return only the fields defined in the schema.',
          },
        ],
      },
    ],
  })

  return Response.json(output)
}
"
`;

exports[`generateDocumentProcessingSchema > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
// Customize these fields to match the documents you are processing.

import { z } from 'zod'

export const documentSchema = z.object({
  title:     z.string().optional().describe('Document title or main heading'),
  summary:   z.string().describe('Brief summary of the document content'),
  keyPoints: z.array(z.string()).describe('Key points or takeaways'),
  date:      z.string().optional().describe('Document date if present (ISO 8601)'),
  author:    z.string().optional().describe('Author or issuing entity'),
  // TODO: add fields specific to your document type, e.g.:
  // invoiceNumber: z.string().optional(),
  // lineItems: z.array(z.object({ description: z.string(), amount: z.number() })).optional(),
})

export type Document = z.infer<typeof documentSchema>
"
`;
