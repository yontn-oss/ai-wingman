// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateImageGenPage > snapshot 1`] = `
"'use client'

// Generated by ai-wingman — edit freely, you own this file.
// Sends a text prompt to /api/image-gen and displays the generated image.
// Includes a download button so the user can save the result.

import { useState } from 'react'
import { Button } from '@/components/ui/button'
import { Textarea } from '@/components/ui/textarea'

const API_PATH = '/api/image-gen'

export default function ImageGenPage() {
  const [prompt, setPrompt] = useState('')
  const [imageUrl, setImageUrl] = useState<string | null>(null)
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState<string | null>(null)

  async function generate() {
    if (!prompt.trim()) return
    setLoading(true)
    setError(null)
    setImageUrl(null)
    try {
      const res = await fetch(API_PATH, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt }),
      })
      if (!res.ok) throw new Error(\`Request failed: \${res.status}\`)
      const data = await res.json() as { url: string }
      setImageUrl(data.url)
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Something went wrong')
    } finally {
      setLoading(false)
    }
  }

  function download() {
    if (!imageUrl) return
    const a = document.createElement('a')
    a.href = imageUrl
    a.download = 'generated-image.png'
    a.click()
  }

  return (
    <div className="max-w-xl mx-auto p-8 flex flex-col gap-6">
      <h1 className="text-2xl font-semibold">Image Generation</h1>

      <div className="flex flex-col gap-3">
        <Textarea
          value={prompt}
          onChange={(e) => setPrompt(e.target.value)}
          placeholder="Describe the image you want to generate…"
          rows={3}
          onKeyDown={(e) => {
            if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) void generate()
          }}
        />
        <Button onClick={() => void generate()} disabled={loading || !prompt.trim()}>
          {loading ? 'Generating…' : 'Generate'}
        </Button>
      </div>

      {error && (
        <p className="text-sm text-destructive">{error}</p>
      )}

      {imageUrl && (
        <div className="flex flex-col gap-3">
          {/* eslint-disable-next-line @next/next/no-img-element */}
          <img src={imageUrl} alt="Generated image" className="w-full rounded-md border" />
          <Button variant="outline" onClick={download}>
            Download image
          </Button>
        </div>
      )}
    </div>
  )
}
"
`;

exports[`generateImageGenRoute > snapshot — no auth 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Accepts { prompt } and returns a generated image as a base64 data URL.
// Requires OPENAI_API_KEY — image generation uses OpenAI DALL·E models.
//
// See: https://sdk.vercel.ai/docs/ai-sdk-core/image-generation

import { generateImage } from 'ai'
import { openai } from '@ai-sdk/openai'

export const maxDuration = 60

export async function POST(req: Request) {
  // TODO: bring your own auth
  // Add session validation here before processing messages. Example with NextAuth:
  //   import { auth } from '@/auth'
  //   const session = await auth()
  //   if (!session) return new Response('Unauthorized', { status: 401 })

  const { prompt } = await req.json() as { prompt: string }

  const { image } = await generateImage({
    model: openai.image('dall-e-3'),
    prompt,
  })

  return Response.json({ url: \`data:\${image.mediaType};base64,\${image.base64}\` })
}
"
`;
