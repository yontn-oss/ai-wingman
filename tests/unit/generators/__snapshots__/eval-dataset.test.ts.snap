exports[`generateEvalDatasetRunner > snapshot 1`] = `
"// Generated by ai-wingman — edit freely, you own this file.
//
// Run with:  npx tsx evals/dataset-runner.ts
//
// Reads every record from dataset.jsonl, calls the model, then uses an
// LLM judge to score each output 0–1 against expectedOutput.
// Exits with code 1 if the mean score falls below PASS_THRESHOLD.

import { createReadStream } from 'node:fs'
import { createInterface } from 'node:readline'
import path from 'node:path'
import { generateText } from 'ai'
import { openai } from '@ai-sdk/openai'

// ── Config ──────────────────────────────────────────────────────────────────
const DATASET_PATH = path.resolve(import.meta.dirname, 'dataset.jsonl')
const MODEL        = openai("gpt-5.4-nano")
const JUDGE_MODEL  = openai("gpt-5.4-nano")
const PASS_THRESHOLD = 0.8   // mean score below this → exit 1

// ── Types ───────────────────────────────────────────────────────────────────
interface DatasetRecord {
  input: string
  expectedOutput: string
}

// ── Helpers ─────────────────────────────────────────────────────────────────
async function loadDataset(): Promise<DatasetRecord[]> {
  const records: DatasetRecord[] = []
  const rl = createInterface({ input: createReadStream(DATASET_PATH), crlfDelay: Infinity })
  for await (const line of rl) {
    if (line.trim()) records.push(JSON.parse(line) as DatasetRecord)
  }
  return records
}

async function scoreWithJudge(output: string, expected: string): Promise<{ score: number; reason: string }> {
  const { text } = await generateText({
    model: JUDGE_MODEL,
    system: 'You are an evaluator. Score whether the output satisfies the expected answer. Respond ONLY with valid JSON.',
    prompt: [
      'Expected answer (or a close paraphrase of it): ' + expected,
      'Model output: ' + output,
      '',
      'Score 1 if the output is correct or equivalent, 0.5 if partially correct, 0 if wrong.',
      'Respond with JSON: { "score": <0|0.5|1>, "reason": "<one sentence>" }',
    ].join('\\n'),
  })
  try {
    const json = JSON.parse(text.match(/\\{[^}]+\\}/)?.[0] ?? '{}') as { score?: number; reason?: string }
    return { score: json.score ?? 0, reason: json.reason ?? text }
  } catch {
    return { score: 0, reason: 'Judge returned non-JSON: ' + text }
  }
}

// ── Runner ──────────────────────────────────────────────────────────────────
async function run() {
  console.log('Loading dataset...')
  const records = await loadDataset()
  console.log(\`Running \${records.length} eval cases\\n\`)

  const results: Array<{ input: string; score: number; reason: string }> = []

  for (const record of records) {
    process.stdout.write(\`  \${record.input.slice(0, 60).padEnd(62)} \`)

    const { text: output } = await generateText({
      model: MODEL,
      system: 'You are a helpful assistant. Answer concisely.',
      prompt: record.input,
    })

    const { score, reason } = await scoreWithJudge(output, record.expectedOutput)
    results.push({ input: record.input, score, reason })

    const icon = score >= 0.8 ? '✓' : score >= 0.5 ? '~' : '✗'
    console.log(\`\${icon}  \${score.toFixed(2)}  \${reason}\`)
  }

  const mean = results.reduce((s, r) => s + r.score, 0) / results.length
  console.log(\`\\nMean score: \${mean.toFixed(2)} / 1.00 (threshold: \${PASS_THRESHOLD})\`)

  const failures = results.filter((r) => r.score < PASS_THRESHOLD)
  if (failures.length > 0) {
    console.log('\\nFailing cases:')
    for (const f of failures) {
      console.log(\`  ✗ \${f.input.slice(0, 60)}: \${f.reason}\`)
    }
  }

  if (mean < PASS_THRESHOLD) {
    console.error(\`\\n✗ Eval failed — mean score \${mean.toFixed(2)} below threshold \${PASS_THRESHOLD}\`)
    process.exit(1)
  }
  console.log('\\n✓ Eval passed')
}

run().catch((err) => { console.error(err); process.exit(1) })
"
`;

exports[`generateEvalDatasetWorkflow > snapshot 1`] = `
"# Generated by ai-wingman — edit freely, you own this file.
#
# Runs the dataset eval suite on every pull request targeting main.
# The job fails if the mean LLM-judge score drops below PASS_THRESHOLD.
# Set OPENAI_API_KEY (or your provider key) as a repository secret.

name: AI Eval

on:
  pull_request:
    branches: [main]
  workflow_dispatch:

jobs:
  eval:
    name: Dataset eval
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - run: npm ci

      - run: npx tsx evals/dataset-runner.ts
        env:
          OPENAI_API_KEY: \${{ secrets.OPENAI_API_KEY }}
"
`;
